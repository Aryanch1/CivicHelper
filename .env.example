# CivicHelper local config — copy to .env for local runs (never commit .env).
# The letter explainer lives at /api/explain on the deployed web app; set
# EXPO_PUBLIC_API_URL to that origin for native builds or local dev
# (e.g. EXPO_PUBLIC_API_URL=https://civichellper.vercel.app). When empty,
# the web app uses its own /api/explain and native builds fall back to
# the on-device demo explainer. No Gemini key ever belongs in this file.
EXPO_PUBLIC_API_URL=
